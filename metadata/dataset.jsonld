      "dcterms:title": [
        {
          "@value": "Ukraine Legacy Admin 3",
          "@language": "en"
        },
        {
          "@value": "Ukraine Legacy Admin 3 — адміністративні межі",
          "@language": "uk"
        }
      ],
      "dcterms:publisher": "Ministry of Infrastructure of Ukraine",
      "dcterms:description": [
        {
          "@value": "Джерело адміністративних меж. Атрибути скоригував Олексій Бойко. URL джерела, дата публікації/актуальності та ліцензія не були надані на час публікації цих метаданих.",
          "@language": "uk"
        },
        {
          "@value": "Source administrative boundary dataset. Attributes were adjusted by Oleksii Boiko. The source URL, publication/reference date and licence had not been supplied when this metadata record was published.",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "https://oleksaboiko.github.io/popmap/#annotation-limitations",
      "@type": "dqv:QualityAnnotation",
      "oa:hasTarget": {
        "@id": "https://oleksaboiko.github.io/popmap/#dataset"
      },
      "oa:hasBody": [
        {
          "@type": "oa:TextualBody",
          "rdf:value": {
            "@value": "Значення чисельності є модельованими оцінками на основі продукту WorldPop із приблизною роздільністю 100 м. Набір успадковує невизначеність демографічних джерел, методів прогнозування та просторового моделювання WorldPop.",
            "@language": "uk"
          }
        },
        {
          "@type": "oa:TextualBody",
          "rdf:value": {
            "@value": "Population values are modelled estimates derived from WorldPop’s approximately 100-metre gridded population product and are not official census counts. Source uncertainty is inherited from WorldPop’s input demographic data, projection methods and spatial modelling.",
            "@language": "en"
          }
        }
      ]
    },
    {
      "@id": "https://oleksaboiko.github.io/popmap/#annotation-use",
      "@type": "dqv:QualityAnnotation",
      "oa:hasTarget": {
        "@id": "https://oleksaboiko.github.io/popmap/#dataset"
      },
      "oa:hasBody": [
        {
          "@type": "oa:TextualBody",
          "rdf:value": {
            "@value": "Рекомендовано для пошукових досліджень і візуалізації, порівняння загальних просторових закономірностей, агрегованого аналізу на рівні громад або вище та визначення територій для подальшого дослідження. Не рекомендовано як єдине джерело для офіційних підсумків населення, оцінок переміщення в реальному часі, юридичних чи виборчих рішень, розподілу гуманітарних ресурсів без підтвердження, аналізу на рівні будівель, ділянок чи домогосподарств або точного річного порівняння дуже малих територій.",
            "@language": "uk"
          }
        },
        {
          "@type": "oa:TextualBody",
          "rdf:value": {
            "@value": "Recommended for exploratory research and visualization, comparison of broad spatial patterns, aggregated analysis at hromada or larger levels, and identifying areas for further investigation. Not recommended as the sole source for official population totals, real-time displacement estimates, legal or electoral decisions, humanitarian resource allocation without corroborating evidence, building-, parcel- or household-level analysis, or precise year-to-year comparison of very small areas.",
            "@language": "en"
          }
        }
      ]
    },
    {
      "@id": "https://oleksaboiko.github.io/popmap/#annotation-territory",
      "@type": "dqv:QualityAnnotation",
      "oa:hasTarget": {
        "@id": "https://oleksaboiko.github.io/popmap/#dataset"
      },
      "oa:hasBody": [
        {
          "@type": "oa:TextualBody",
          "rdf:value": {
            "@value": "Набір охоплює міжнародно визнану територію України без географічних винятків, включно з усіма тимчасово окупованими територіями. Для всіх шести років використано єдину фіксовану географію; зміни показників не спричинені щорічними змінами меж.",
            "@language": "uk"
          }
        },
        {
          "@type": "oa:TextualBody",
          "rdf:value": {
            "@value": "The dataset covers the internationally recognized territory of Ukraine without geographic exclusions, including all temporarily occupied territories. One fixed geography is used for all six years, so displayed changes are not caused by annual boundary changes.",
            "@language": "en"
          }
        }
      ]
    },
    {
      "@id": "https://oleksaboiko.github.io/popmap/#annotation-special-units",
      "@type": "dqv:QualityAnnotation",
      "oa:hasTarget": {
        "@id": "https://oleksaboiko.github.io/popmap/#dataset"
      },
      "oa:hasBody": [
        {
          "@type": "oa:TextualBody",
          "rdf:value": {
            "@value": "Для повного просторового покриття збережено шість державних територій, що не є громадами: Чорнобильську зону відчуження та п’ять великих водойм. Значення для полігонів водойм є артефактами перетину комірок растра й не означають населення, що проживає у водоймах.",
            "@language": "uk"
          }
        },
        {
          "@type": "oa:TextualBody",
          "rdf:value": {
            "@value": "Six state territories are retained for complete spatial coverage: the Chornobyl Exclusion Zone and five major water bodies. Values assigned to water-body polygons are raster-cell intersection artefacts and do not represent residents of those water bodies.",
            "@language": "en"
          }
        }
      ]
    },
