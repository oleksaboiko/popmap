  "@graph": [
    {
      "@id": "https://oleksaboiko.github.io/popmap/#dataset",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "dcterms:identifier": "https://oleksaboiko.github.io/popmap/#dataset",
      "dcterms:title": [
        {
          "@value": "Зміна чисельності населення адміністративних територій України, 2021–2026",
          "@language": "uk"
        },
        {
          "@value": "Population change in Ukrainian administrative areas, 2021–2026",
          "@language": "en"
        }
      ],
      "dcterms:abstract": [
        {
          "@value": "Модельовані річні оцінки та прогнози чисельності населення для 1 780 адміністративних і спеціальних територій України на 1 січня 2021–2026 років.",
          "@language": "uk"
        },
        {
          "@value": "Modelled annual population estimates and projections for 1,780 administrative and special territories of Ukraine on 1 January 2021–2026.",
          "@language": "en"
        }
      ],
      "dcterms:description": [
        {
          "@value": "Набір поєднує адміністративні межі громад (NUTS 3) із модельованими растрами WorldPop із приблизною просторовою роздільністю 100 м. Значення комірок розподілено між полігонами пропорційно площі перетину; результати округлено до цілих осіб. Геометрію спрощено на 100 м після обчислення показників для ефективного вебвідображення.",
          "@language": "uk"
        },
        {
          "@value": "The dataset combines a fixed administrative boundaries  (NUTS 3) with approximately 100-metre WorldPop modelled population rasters. Grid-cell values were allocated to polygons in proportion to intersection area and rounded to whole persons. Geometry was simplified by 100 metres after the population calculation for efficient web display.",
          "@language": "en"
        }
      ],
      "dcterms:creator": {
